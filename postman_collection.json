            "url": {
              "raw": "{{base_url}}/items/{{finished_product_id}}/recipe",
              "host": ["{{base_url}}"],
              "path": ["items", "{{finished_product_id}}", "recipe"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "All stock",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/inventory",
              "host": ["{{base_url}}"],
              "path": ["inventory"]
            },
            "description": "Every item across all three stages, with quantity on hand. Items that have never moved show zero rather than going missing."
          }
        },
        {
          "name": "Stock by stage",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/inventory/stage/raw",
              "host": ["{{base_url}}"],
              "path": ["inventory", "stage", "raw"],
              "variable": []
            },
            "description": "Swap the last path segment for `raw`, `semi_finished`, or `finished`. Anything else returns 404."
          }
        },
        {
          "name": "Low stock",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/inventory/low-stock?type=",
              "host": ["{{base_url}}"],
              "path": ["inventory", "low-stock"],
              "query": [
                {
                  "key": "type",
                  "value": "",
                  "description": "optional: raw, semi_finished, finished"
                }
              ]
            },
            "description": "Items at or below their reorder level. This feeds the dashboard alert panel."
          }
        },
        {
          "name": "Receive stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('batch_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": {{raw_material_id}},\n  \"quantity\": \"250\",\n  \"produced_at\": \"2026-08-01T09:00:00Z\",\n  \"note\": \"Delivery from supplier\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventory/receipts",
              "host": ["{{base_url}}"],
              "path": ["inventory", "receipts"]
            },
            "description": "Raw materials only. `produced_at` is optional and sets the batch date, which decides the FIFO order when the batch is later consumed."
          }
        },
        {
          "name": "Item movements",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/items/{{raw_material_id}}/movements",
              "host": ["{{base_url}}"],
              "path": ["items", "{{raw_material_id}}", "movements"]
            },
            "description": "The full ledger for one item. Every increase and decrease, with what caused it. Add up the quantities and you get the current stock, which is the audit trail behind the number."
          }
        }
      ]
    },
    {
      "name": "Production orders",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/production-orders?stage=&status=&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["production-orders"],
              "query": [
                {
                  "key": "stage",
                  "value": "",
                  "description": "raw_to_semi_finished or semi_finished_to_finished"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "pending, completed, failed, cancelled"
                },
                { "key": "per_page", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('production_order_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"output_item_id\": {{semi_finished_id}},\n  \"planned_quantity\": \"20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/production-orders",
              "host": ["{{base_url}}"],
              "path": ["production-orders"]
            },
            "description": "The stage comes from the output item's type, so you never send it. Ask for a raw material as output and you get 422, because raw materials are bought, not made."
          }
        },
        {
          "name": "Show",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/production-orders/{{production_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["production-orders", "{{production_order_id}}"]
            },
            "description": "Includes the output batch and the input batches it consumed, once the order has run."
          }
        },
        {
          "name": "Execute",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/production-orders/{{production_order_id}}/execute",
              "host": ["{{base_url}}"],
              "path": ["production-orders", "{{production_order_id}}", "execute"]
            },
            "description": "Locks, allocates FIFO, consumes, produces, all in one transaction.\n\n- 200: done, with the new batch\n- 422: not enough stock, with the exact shortfall, and nothing was changed\n- 409: the order was not pending, so it already ran"
          }
        },
        {
          "name": "Execute (not enough stock)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// create a deliberately impossible order so this request always",
                  "// demonstrates the rejection path, never a stale 409",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('base_url') + '/production-orders',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Accept': 'application/json',",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + pm.collectionVariables.get('token'),",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            output_item_id: pm.collectionVariables.get('semi_finished_id'),",
                  "            planned_quantity: '999999',",
                  "        }),",
                  "    },",
                  "}, (err, res) => {",
                  "    pm.collectionVariables.set('oversized_order_id', res.json().data.id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 rejected', () => pm.response.to.have.status(422));",
                  "pm.test('says what is missing', () => pm.expect(pm.response.json().message).to.include('short by'));",
                  "",
                  "console.log(pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/production-orders/{{oversized_order_id}}/execute",
              "host": ["{{base_url}}"],
              "path": ["production-orders", "{{oversized_order_id}}", "execute"]
            },
            "description": "The failure path. A script before this request creates an order for 999999 units, which no stock can cover.\n\nThe message names the item, what was needed, what was there, and how much was missing. Check inventory afterwards and nothing moved. The whole transaction rolled back, so there is no half consumed batch to clean up."
          }
        }
      ]
    },
    {
      "name": "Batches and traceability",
      "item": [
        {
          "name": "List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const first = pm.response.json().data[0];",
                  "if (first) { pm.collectionVariables.set('batch_id', first.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/batches?search=&item_type=&origin=&available_only=&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["batches"],
              "query": [
                { "key": "search", "value": "", "description": "batch number, sku, or item name" },
                { "key": "item_type", "value": "", "description": "raw, semi_finished, finished" },
                { "key": "origin", "value": "", "description": "purchase or production" },
                { "key": "available_only", "value": "", "description": "true hides used up batches" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "One table for all three stages. `origin` tells you whether a batch was bought or made."
          }
        },
        {
          "name": "Show",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/batches/{{batch_id}}",
              "host": ["{{base_url}}"],
              "path": ["batches", "{{batch_id}}"]
            }
          }
        },
        {
          "name": "Trace upstream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/batches/{{batch_id}}/trace",
              "host": ["{{base_url}}"],
              "path": ["batches", "{{batch_id}}", "trace"]
            },
            "description": "Where did this come from? Returns the whole tree down to the purchase batches, with the quantity taken at every step."
          }
        },
        {
          "name": "Trace downstream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/batches/{{batch_id}}/trace-downstream",
              "host": ["{{base_url}}"],
              "path": ["batches", "{{batch_id}}", "trace-downstream"]
            },
            "description": "Where did this go? Point it at a bad raw material batch and you get every finished product affected."
          }
        }
      ]
    },
    {
      "name": "Production events",
      "item": [
        {
          "name": "Event log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/production-events?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["production-events"],
              "query": [{ "key": "per_page", "value": "15", "description": "1 to 100" }]
            },
            "description": "Read only. Every row was written by the RabbitMQ worker, not by a web request.\n\nTo prove the pipeline is really asynchronous: stop the worker with `docker compose stop worker`, execute an order, and watch it succeed while this list stays unchanged and the queue at http://localhost:15672 holds one message. Start the worker again and the row appears."
          }
        }
      ]
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["auth", "logout"]
        },
        "description": "Deletes the token that made this call. Other tokens for the same user keep working.\n\nIt sits at the bottom on purpose. Run it earlier and everything below it gets 401."
      }
    }
  ]
}
