APP_NAME="Production Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=production_management
DB_USERNAME=pms_user
DB_PASSWORD=pms_secret

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=pms_user
RABBITMQ_PASSWORD=pms_secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=production.events
RABBITMQ_QUEUE=production.events.processing
RABBITMQ_DLX=production.events.dlx
RABBITMQ_DLQ=production.events.dlq

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=database

# the React dev server — this is the only allowed CORS origin
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pms@example.com"
MAIL_FROM_NAME="${APP_NAME}"
