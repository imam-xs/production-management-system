# The application code is bind-mounted at runtime, so the build context only
# needs the entrypoint script. Excluding these keeps the context small and the
# build fast — vendor/ alone is tens of thousands of files.
vendor/
node_modules/
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.env
.git/
.phpunit.result.cache
.phpunit.cache/
tests/
